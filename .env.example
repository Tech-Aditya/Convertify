# Convertify runs with no environment variables at all; every value below is optional.
# Copy to .env (or set them in your shell / the Render or Railway dashboard).
# Never commit a real .env file.

# --- Runtime ---
# Set automatically by Render/Railway; local default is 8090.
PORT=
# dev (local default) | prod | prod,container (set by the Docker image: stdout-only logs)
SPRING_PROFILES_ACTIVE=

# --- Currency provider (defaults to the open ExchangeRate-API endpoint; no key needed) ---
# URL template with {base} and optional {apiKey} placeholders
CURRENCY_PROVIDER_URL=
# Secret: only for keyed providers
CURRENCY_API_KEY=
# Send the key in this HTTP header instead of the URL
CURRENCY_API_KEY_HEADER=
# How long rates are cached, e.g. 6h
CURRENCY_CACHE_TTL=

# --- Behaviour ---
# Defines "today" for the date calculator, e.g. Asia/Kolkata
DATE_DEFAULT_TIME_ZONE=
# e.g. WEST_BENGAL
LAND_DEFAULT_REGION=
# Only if the frontend is hosted on a different origin
CORS_ALLOWED_ORIGINS=

# --- Logging ---
# INFO | DEBUG
LOG_LEVEL_APP=
